{
  "private": true,
  "type": "module",
  "name": "nfreear.github.io",
  "version": "1.9.6",
  "description": "Experimental! I'm re-developing my blog, using Jekyll and GitHub pages. | © 2009-2026 NDF.",
  "main": "./Gruntfile.js",
  "engines": {
    "node": ">= 11"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@zachleat/heading-anchors": "^1.0.5",
    "luxon": "^3.7.2",
    "prismjs": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "simple-git-hooks": "^2.14.0"
  },
  "x_cdnDependencies": {
    "jquery": "3.3.1",
    "html5shiv": "3.7.3",
    "respond.js": "1.4.2",
    "gaad-widget": "^3",
    "github-describe": "^1",
    "isad-widget": "^1.1",
    "cookie-notice": "^1",
    "jquery-oembed": "https://embed.open.ac.uk/scripts/jquery.oembed.js#^1.0",
    "staticman-api": "https://api.staticman.net/v2/#^2.0",
    "intensedebate": "https://intensedebate.com/js/genericCommentWrapper2.php#^2.0",
    "atbar": "https://core.atbar.org/atbar/en/latest/atbar.min.js#^1.0",
    "google-analytics": "https://www.google-analytics.com/analytics.js#^1.0"
  },
  "scripts": {
    "clean": "rm -rf _site",
    "build": "npx @11ty/eleventy",
    "start": "npx @11ty/eleventy --serve --quiet",
    "lint": "npx eslint",
    "lint:fix": "npx eslint --fix",
    "test": "npx eslint",
    "retag": "node ./_bin/rewriteTags.js",
    "count": "grunt exec:count",
    "pa11y-ci": "pa11y-ci --config .pa11yci.json",
    "new-post": "make new-post",
    "grep": "node ./_bin/grepPosts.js",
    "grep:high": "grep -rn '{% highlight' _posts",
    "grep:elem": "grep -rn --exclude-dir=_site '<my-' _posts _pages",
    "jsonlint": "php -r 'print_r(json_decode(file_get_contents(\"package.json\")));'",
    "prepare": "simple-git-hooks"
  },
  "repository": "https://github.com/nfreear/nfreear.github.io",
  "author": "Nick Freear {@nfreear}",
  "license": "(MIT AND CC-BY-SA-4.0)",
  "homepage": "https://nick.freear.org.uk/",
  "egg": "Happy birthday to you!",
  "keywords": [],
  "contributors": [],
  "x-count": {
    "drafts": 23,
    "posts": 66,
    "total": 89
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint"
  }
}
